{
  "name": "file-parsing-pipeline",
  "version": "1.0.0",
  "environment": "development",
  "port": 8080,
  "debug": false,
  "start_delay": 0,
  "origins": {
    "enabled": true,
    "domains": ["http://localhost:5173", "http://127.0.0.1:5173"]
  },
  "k8s": {
    "readiness": {
      "period": 10,
      "threshold": 3
    },
    "liveness": {
      "period": 10,
      "threshold": 3
    }
  }
}
