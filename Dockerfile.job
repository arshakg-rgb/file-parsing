FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build
COPY src/services/job-service/start.js ./dist/services/job-service/start.js
ENV NODE_ENV=production
ENV PORT=8080
COPY configs/ ./configs/
CMD ["node", "dist/services/job-service/start.js"]
