# ============================================================
# file-parsing-pipeline-node — environment example
# ============================================================

# ---- Environment ----
# Set to "production" in deployed environments so auth cookies are marked
# Secure (HTTPS-only). Left as "development" locally so cookies still work
# over plain HTTP on localhost.
NODE_ENV=development

# ---- Server ----
PORT=8080

# ---- Auth cookies ----
# SameSite: Strict (default for local same-site), Lax, or None.
# For local Vite same-site development keep Strict/Secure=false.
# For Cloud Run cross-site production use:
#   COOKIE_SAMESITE=None
#   COOKIE_SECURE=true
#   CORS_DOMAINS=https://your-spa-origin\.run\.app
# SameSite=None is only safe with the Origin/Referer CSRF middleware;
# make sure CORS_DOMAINS tightly matches your real UI origin.
COOKIE_SAMESITE=Strict
# COOKIE_DOMAIN=.example.com
COOKIE_SECURE=false

# ---- Database ----
FILE_DATABASE_URL=postgresql://postgres:password@34.61.165.242:5432/datalead_osint

# ---- Google Cloud Platform ----
GCP_PROJECT_ID=data-etl-499916
GOOGLE_APPLICATION_CREDENTIALS=src/configs/service-account-key.json

# ---- Firebase Authentication ----
# Token verification/logout use the same GOOGLE_APPLICATION_CREDENTIALS /
# GCP_PROJECT_ID above via Application Default Credentials. The GCP
# project must have Firebase Authentication enabled and the service
# account must have the "Firebase Authentication Admin" IAM role.
# Signup/login/refresh (POST /v1/auth/signup, /login, /refresh) call the
# public Identity Toolkit REST API and require this Web API key, found in
# Firebase Console -> Project settings -> General -> Web API Key.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# ---- Queue Backend ----
QUEUE_BACKEND=pubsub

# ---- Queue URLs (for pubsub, use topic names; for sqs, use full URLs) ----
INGEST_QUEUE_URL=fpp-ingest
CLASSIFY_QUEUE_URL=fpp-classify
PARSE_QUEUE_URL=fpp-parse
DLQ_QUEUE_URL=fpp-line-dlq
LOAD_QUEUE_URL=fpp-load
REPORT_QUEUE_URL=fpp-report
JOB_EVENTS_QUEUE_URL=fpp-job-events

# ---- Storage ----
DATA_BUCKET=datalead-osint
DEPLOYMENT_BUCKET=datalead-osint

# ---- Firestore ----
FIRESTORE_DATABASE_ID=file-parsing-db
TEMPLATE_COLLECTION=file-parsing-templates

# ---- AI Classifier ----
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022

# ---- Health Check ----
HEALTH_CHECK_PORT=8080

# ---- Loki / Grafana ----
LOKI_HOST=https://logs-prod-021.grafana.net
FILE_LOKI_USERNAME=1681394
FILE_LOKI_PASSWORD=your-grafana-cloud-api-token
